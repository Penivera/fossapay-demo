{
  "name": "fossapay-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "FossaPay showcase applications and demo portfolio",
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs --live",
    "dev:offramp": "npm run dev --workspace=demos/near-offramp",
    "dev:safedeal": "npm run dev --workspace=demos/safedeal",
    "dev:squadpay": "npm run dev --workspace=demos/squadpay",
    "dev:ajosphere": "npm run dev --workspace=demos/ajosphere",
    "dev:gateway": "npm run dev --workspace=packages/webhook-gateway",
    "gateway": "npm run start --workspace=packages/webhook-gateway"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Penivera/fossapay-demo.git"
  },
  "bugs": {
    "url": "https://github.com/Penivera/fossapay-demo/issues"
  },
  "homepage": "https://fossapay-demo.peni.dev",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "keywords": [
    "fossapay",
    "nigeria",
    "payments",
    "fintech",
    "ngn",
    "nextjs",
    "typescript",
    "demo"
  ]
}
