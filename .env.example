# Shared example for the FossaPay demos.
# The Next.js apps read their own .env.local (copy this file there).
# The webhook gateway reads these names from its process environment (Coolify: add them as env vars).

# mock (default) = offline, no money. live = real FossaPay production API (moves real money).
FOSSAPAY_MODE=mock

# Required when FOSSAPAY_MODE=live. Server-side only: never prefix with NEXT_PUBLIC_.
FOSSAPAY_API_KEY=
FOSSAPAY_WEBHOOK_SECRET=

# Optional overrides / legacy names
# FOSSAPAY_BASE_URL=https://api-production.fossapay.com/api/v1
# FOSSAPAY_SECRET=                 # legacy alias for FOSSAPAY_WEBHOOK_SECRET (gateway only)
# FOSSAPAY_WEBHOOK_URL=            # mock only: where the mock ledger delivers webhooks
# REDIS_URL=redis://localhost:6379 # gateway only: shared event history
# PORT=8001                        # gateway only
