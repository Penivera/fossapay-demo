# FossaPay Environment Configuration
# Mode: "mock" (default, runs 100% offline) or "live" (requires real production keys)
FOSSAPAY_MODE=mock

# Live API credentials (used only when FOSSAPAY_MODE=live)
FOSSAPAY_API_KEY=fk_production_xxxxxxxxxxxxxxxxxxxxxxxx
FOSSAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
FOSSAPAY_BASE_URL=https://api-production.fossapay.com/api/v1

# FossaPay Master Solana Vault Address for Solver Delivery
FOSSAPAY_SOLANA_MASTER_ADDRESS=FossaPaySolanaMasterVault1111111111111111111
