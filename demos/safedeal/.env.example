# Copy to .env.local. Sandbox is the default; nothing here is needed for offline demos.
FOSSAPAY_MODE=mock

# Live mode (real money): fill both in. Never prefix with NEXT_PUBLIC_ or commit real values.
FOSSAPAY_API_KEY=
FOSSAPAY_WEBHOOK_SECRET=

# Optional
# FOSSAPAY_BASE_URL=https://api-production.fossapay.com/api/v1
