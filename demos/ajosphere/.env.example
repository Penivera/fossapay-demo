# FossaPay Mode: 'mock' (default, 100% offline) or 'live' (https://api-production.fossapay.com/api/v1)
FOSSAPAY_MODE=mock
FOSSAPAY_API_KEY=fossa_live_secret_key_mock_placeholder
FOSSAPAY_WEBHOOK_SECRET=fossa_whsec_mock_shared_secret

# AjoSphere Webhook URL for local webhook dispatching
NEXT_PUBLIC_APP_URL=http://localhost:3003
