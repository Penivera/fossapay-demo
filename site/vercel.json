{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/images/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ],
  "rewrites": [
    { "source": "/safedeal", "destination": "https://fossapay-safedeal.vercel.app/safedeal" },
    { "source": "/safedeal/:path*", "destination": "https://fossapay-safedeal.vercel.app/safedeal/:path*" },
    { "source": "/squadpay", "destination": "https://fossapay-squadpay.vercel.app/squadpay" },
    { "source": "/squadpay/:path*", "destination": "https://fossapay-squadpay.vercel.app/squadpay/:path*" },
    { "source": "/ajosphere", "destination": "https://fossapay-ajosphere.vercel.app/ajosphere" },
    { "source": "/ajosphere/:path*", "destination": "https://fossapay-ajosphere.vercel.app/ajosphere/:path*" },
    { "source": "/near-offramp", "destination": "https://fossapay-near-offramp.vercel.app/near-offramp" },
    { "source": "/near-offramp/:path*", "destination": "https://fossapay-near-offramp.vercel.app/near-offramp/:path*" },
    { "source": "/api/deals/:path*", "destination": "https://fossapay-safedeal.vercel.app/safedeal/api/deals/:path*" },
    { "source": "/api/rooms/:path*", "destination": "https://fossapay-squadpay.vercel.app/squadpay/api/rooms/:path*" },
    { "source": "/api/clubs/:path*", "destination": "https://fossapay-ajosphere.vercel.app/ajosphere/api/clubs/:path*" },
    { "source": "/api/intents/:path*", "destination": "https://fossapay-near-offramp.vercel.app/near-offramp/api/intents/:path*" },
    { "source": "/api/quote", "destination": "https://fossapay-near-offramp.vercel.app/near-offramp/api/quote" },
    { "source": "/api/banks", "destination": "https://fossapay-safedeal.vercel.app/safedeal/api/banks" },
    { "source": "/api/banks/:path*", "destination": "https://fossapay-safedeal.vercel.app/safedeal/api/banks/:path*" }
  ]
}
